# Python 3.10+; copy this file to .env locally, or use your host's secret settings.
# Never commit .env or real credentials. Environment variables override .env.
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Replace this entire example with your provider's PostgreSQL URL.
# URL-encode special characters in the database username/password.
# Keep any SSL options required by your provider (e.g. ?sslmode=require).
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME
# Legacy SQLALCHEMY_DATABASE_URI is supported if DATABASE_URL is not set.
COOKIE_SECURE=true
# Set COOKIE_SECURE=false ONLY for local development over plain HTTP.

# Fill these in yourself before running the one-time create-admin command.
# Login uses ADMIN_EMAIL, not ADMIN_NAME. Use a unique password of 12+ characters.
# Quote values containing spaces or # when editing this file.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Deployment (run from the repository root):
# python -m pip install -r requirements.txt
# flask --app main:app db upgrade
# flask --app main:app create-admin
# gunicorn --bind 0.0.0.0:${PORT:-8000} main:app
# Remove ADMIN_PASSWORD from your deployment environment after creating the admin.
# Re-running create-admin never resets passwords or promotes an existing resident.
# Migrations target a NEW database; changing the URL does NOT copy SQLite data.
# Back up and migrate existing SQLite data separately before switching production.
# Existing unversioned databases require a schema review before using migrations.
# Persist cleanalert/static/uploads and cleanalert/static/profile_pics on your host;
# local uploads disappear on hosts with ephemeral disks (or use object storage).
